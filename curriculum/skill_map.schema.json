{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "技能 -> 教程映射表（skill_map）",
  "description": "从岗位 JD 抽取的待学技能清单与教程规划占位；本期只做映射结构与清单，不写教程正文。",
  "type": "object",
  "required": ["version", "date", "skills"],
  "properties": {
    "version": { "type": "string", "description": "映射表版本号" },
    "date": { "type": "string", "format": "date", "description": "生成日期 YYYY-MM-DD" },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["skill", "category", "demand_count", "priority", "resource_status"],
        "properties": {
          "skill": { "type": "string", "description": "技能/技术名（规范写法）" },
          "category": {
            "type": "string",
            "description": "技能分组",
            "enum": ["编程语言", "Android体系", "音视频/通信", "鸿蒙/跨端", "AI/大模型", "架构/性能/质量", "后端/大数据/云", "汽车/座舱/嵌入式", "业务/管理/行业"]
          },
          "demand_count": { "type": "integer", "minimum": 0, "description": "本期出现该技能的岗位数（覆盖数）" },
          "freq": { "type": "integer", "minimum": 0, "description": "本期关键词总词频" },
          "priority": { "type": "string", "enum": ["高", "中", "低"], "description": "学习优先级，按需求度 + 与现有技术栈差距评定" },
          "prerequisites": { "type": "array", "items": { "type": "string" }, "description": "前置技能（技能名，对应本表 skill）" },
          "outline_placeholder": { "type": "string", "description": "教程大纲占位；本期留空，后续补写" },
          "resource_status": { "type": "string", "enum": ["todo", "drafting", "done"], "description": "教程产出状态" },
          "source_jobs": { "type": "array", "items": { "type": "string" }, "description": "命中该技能的来源岗位 URL 留痕" }
        },
        "additionalProperties": false
      }
    }
  }
}
